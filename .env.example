DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=genera-una-clave-con-secrets.token_urlsafe
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes desde los que un navegador puede llamar a esta API (CORS).
# Sin esto, el frontend no puede consumir la API desde el navegador.
# Ejemplo para un frontend Vite/React corriendo en local:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=invernadero
POSTGRES_USER=invernadero
POSTGRES_PASSWORD=pon-aqui-una-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
# Backend de caché de Django (política de persistencia de lecturas,
# "último valor conocido" para el snapshot de WebSocket). Usa una base
# de Redis distinta a REDIS_URL para no mezclar el channel layer con
# el caché.
REDIS_CACHE_URL=redis://redis:6379/1
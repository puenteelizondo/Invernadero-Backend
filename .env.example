DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=genera-una-clave-con-secrets.token_urlsafe
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes desde los que un navegador puede llamar a esta API (CORS).
# Sin esto, el frontend no puede consumir la API desde el navegador.
# Ejemplo para un frontend Vite/React corriendo en local:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Orígenes desde los que se acepta un POST/PUT/PATCH/DELETE autenticado
# por SESIÓN (cookie), protección CSRF de Django. Distinto de CORS de
# arriba: CORS controla si el navegador deja LEER la respuesta; esto
# controla si Django ACEPTA la petición. Hace falta en desarrollo por
# el proxy de Vite (el navegador manda Origin: http://localhost:5173
# aunque la petición llegue a Django en localhost:8000) -- sin esto,
# todo login/logout/POST de escritura falla con
# "CSRF Failed: Origin checking failed". Incluye el esquema.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=invernadero
POSTGRES_USER=invernadero
POSTGRES_PASSWORD=pon-aqui-una-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
# Backend de caché de Django (política de persistencia de lecturas,
# "último valor conocido" para el snapshot de WebSocket). Usa una base
# de Redis distinta a REDIS_URL para no mezclar el channel layer con
# el caché.
REDIS_CACHE_URL=redis://redis:6379/1

# --- Solo producción (config/settings/prod.py) --------------------------
# Sin efecto en desarrollo (config/settings/dev.py no las usa). Ver
# docker-compose.prod.yml para cómo se activa DJANGO_SETTINGS_MODULE.
# (CSRF_TRUSTED_ORIGINS ya no va aquí -- se movió arriba porque ahora
# también hace falta en desarrollo, por el proxy de Vite. En producción
# simplemente pon ahí el/los dominio(s) reales en vez de localhost.)
#
# Segundos que SECURE_HSTS_SECONDS le pide al navegador que recuerde
# "entra siempre por HTTPS a este dominio". Por defecto 7 días si no
# la defines.
# SECURE_HSTS_SECONDS=604800

# --- Email (recuperación de contraseña, apps/users) ----------------------
# Sin configurar nada de esto, el correo se imprime en los logs
# (`docker compose logs web`) en vez de enviarse de verdad -- sirve
# para probar el flujo en desarrollo sin credenciales reales. Para que
# se mande un correo de verdad (típicamente en producción), define:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-letras
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Invernadero <tu-cuenta@gmail.com>
# Prueba: docker compose exec web python manage.py sendtestemail tu-correo@ejemplo.com
#
# Dirección pública del frontend, para el enlace del correo de recuperación
# y el de las alertas (sin "/" al final):
# FRONTEND_URL=https://invernadero.tu-dominio.com

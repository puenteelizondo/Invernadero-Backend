{
	"info": {
		"name": "Invernadero-Backend",
		"description": "Colección completa de la API de Invernadero-Backend (Django/DRF). Usa las variables de la colección (base_url, username, password) y, para los endpoints de dispositivo, device_key. La autenticación por defecto de la colección es Basic Auth con {{username}}/{{password}}; los endpoints de sesión (login/logout/me/csrf) y los de dispositivo (X-Device-Key) se documentan aparte porque no usan ese esquema.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1"
		},
		{
			"key": "username",
			"value": "cliente1"
		},
		{
			"key": "password",
			"value": "cambia-esto"
		},
		{
			"key": "device_key",
			"value": "pega-aqui-la-api_key-de-un-device"
		},
		{
			"key": "greenhouse_id",
			"value": "1"
		},
		{
			"key": "sensor_id",
			"value": "1"
		},
		{
			"key": "actuator_id",
			"value": "1"
		},
		{
			"key": "device_id",
			"value": "1"
		},
		{
			"key": "membership_id",
			"value": "1"
		},
		{
			"key": "user_id",
			"value": "1"
		},
		{
			"key": "loop_id",
			"value": "1"
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{username}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{password}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Recuperar contraseña - pedir enlace",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"url": "{{base_url}}/auth/password-reset/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"cliente1@example.com\"\n}"
						}
					}
				},
				{
					"name": "Recuperar contraseña - confirmar",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"url": "{{base_url}}/auth/password-reset/confirm/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"uid\": \"pega-aqui-el-uid-del-enlace-del-correo\",\n  \"token\": \"pega-aqui-el-token-del-enlace-del-correo\",\n  \"password\": \"mi-nueva-contraseña-456\"\n}"
						}
					}
				},
				{
					"name": "Cookie CSRF (para login/logout de sesión)",
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"url": "{{base_url}}/auth/csrf/",
						"description": "Pide la cookie 'csrftoken'. Necesario antes de login/logout de sesión si vas a probarlos desde Postman con 'Send cookies' activado, igual que hace el frontend con ensureCsrfCookie()."
					}
				},
				{
					"name": "Login (sesión + cookie)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-CSRFToken",
								"value": "{{csrf_token}}"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"url": "{{base_url}}/auth/login/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"description": "Crea una sesión (cookie sessionid) en vez de usar Basic Auth. Pensado para el frontend, no para Postman -- se incluye para poder probar el endpoint tal cual lo usa el frontend. Requiere haber pedido antes la cookie CSRF y mandarla como header X-CSRFToken."
					}
				},
				{
					"name": "Quién soy (/auth/me/)",
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"url": "{{base_url}}/auth/me/",
						"description": "Usa la sesión (cookie) creada por Login. Con Basic Auth (el default de la colección) también funciona, ya que es solo IsAuthenticated."
					}
				},
				{
					"name": "Logout (sesión)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-CSRFToken",
								"value": "{{csrf_token}}"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"url": "{{base_url}}/auth/logout/"
					}
				}
			]
		},
		{
			"name": "Usuarios (solo administradores)",
			"description": "El registro público está cerrado. Requiere sesión de un usuario is_staff.",
			"item": [
				{
					"name": "Listar usuarios",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/admin/users/?search=&is_active=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"admin",
								"users"
							],
							"query": [
								{
									"key": "search",
									"value": ""
								},
								{
									"key": "is_active",
									"value": "true"
								}
							]
						}
					}
				},
				{
					"name": "Crear usuario (sin password → temporal, se muestra una vez)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/admin/users/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"admin",
								"users"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"operador1\",\n  \"email\": \"op@example.com\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Pérez\",\n  \"is_staff\": false\n}"
						}
					}
				},
				{
					"name": "Editar usuario / desactivar",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/admin/users/{{user_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"admin",
								"users",
								"{{user_id}}"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"is_active\": false\n}"
						}
					}
				},
				{
					"name": "Generar contraseña temporal",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/admin/users/{{user_id}}/reset-password/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"admin",
								"users",
								"{{user_id}}",
								"reset-password"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{}"
						}
					}
				}
			]
		},
